{
  "name": "klipper-doctor",
  "version": "0.2.0",
  "description": "Explains why a Klipper print or session died and lints the printer config, from a klippy.log or printer.cfg.",
  "keywords": [
    "klipper",
    "klippy",
    "klippy.log",
    "printer.cfg",
    "moonraker",
    "3d-printing",
    "3d-printer",
    "gcode",
    "linter",
    "diagnostics",
    "cli"
  ],
  "license": "MIT",
  "author": "kd-011",
  "homepage": "https://github.com/kd-011/klipper-doctor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kd-011/klipper-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/kd-011/klipper-doctor/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "klipper-doctor": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "docs": "node scripts/gen-rules-table.mjs",
    "assets": "node scripts/render-assets.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "bench": "node scripts/bench.mjs",
    "check-samples": "node scripts/check-samples.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "version": "node scripts/sync-version.mjs && npm run build && git add src/core/version.ts dist",
    "prepublishOnly": "npm run check && npm test && node scripts/gen-rules-table.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
